+def _newton_schulz(grad, steps):
+    """Quintic Newton-Schulz iteration: approximately ``U @ V.T`` of ``grad``'s
+    SVD, computed in bf16 (coefficients from Keller Jordan's Muon)."""
+    a, b, c = 3.4445, -4.7750, 2.0315
+    x = grad.bfloat16()
+    tall = grad.size(0) > grad.size(1)
+    if tall:
+        x = x.T
+    x = x / (x.norm() + 1e-7)
+    for _ in range(steps):
+        gram = x @ x.T
+        x = a * x + (b * gram + c * gram @ gram) @ x
+    return x.T if tall else x
+
+
+class MuonAdamW(torch.optim.Optimizer):
+    """Muon for groups with ``use_muon``, AdamW for the rest, in one optimizer
+    so the LR scheduler and checkpoints see a single set of param groups.
+
+    Follows "Muon is Scalable for LLM Training" (Liu et al. 2025): decoupled
+    weight decay, Nesterov momentum, and each Muon update scaled by
+    ``0.2 * sqrt(max(A, B))`` so its RMS matches AdamW's and both kinds of
+    group share one learning rate and weight decay."""
+
+    def __init__(
+        self, params, lr, weight_decay, betas, momentum=0.95, eps=1e-8, ns_steps=5
+    ):
+        defaults = dict(
+            lr=lr,
+            weight_decay=weight_decay,
+            betas=tuple(betas),
+            momentum=momentum,
+            eps=eps,
+            ns_steps=ns_steps,
+            use_muon=False,
+        )
+        super().__init__(params, defaults)
+
+    @torch.no_grad()
+    def step(self, closure=None):
+        for group in self.param_groups:
+            lr, weight_decay = group["lr"], group["weight_decay"]
+            for param in group["params"]:
+                if param.grad is None:
+                    continue
+                grad, state = param.grad, self.state[param]
+                param.mul_(1 - lr * weight_decay)
+                if group["use_muon"]:
+                    momentum = group["momentum"]
+                    if not state:
+                        state["momentum_buffer"] = torch.zeros_like(param)
+                    buffer = state["momentum_buffer"]
+                    buffer.mul_(momentum).add_(grad)
+                    update = _newton_schulz(
+                        grad.add(buffer, alpha=momentum), group["ns_steps"]
+                    )
+                    scale = 0.2 * math.sqrt(max(param.shape))
+                    param.add_(update.to(param.dtype), alpha=-lr * scale)
+                    continue
+                beta1, beta2 = group["betas"]
+                if not state:
+                    state["step"] = 0
+                    state["exp_avg"] = torch.zeros_like(param)
+                    state["exp_avg_sq"] = torch.zeros_like(param)
+                state["step"] += 1
+                exp_avg, exp_avg_sq = state["exp_avg"], state["exp_avg_sq"]
+                exp_avg.lerp_(grad, 1 - beta1)
+                exp_avg_sq.mul_(beta2).addcmul_(grad, grad, value=1 - beta2)
+                bias1 = 1 - beta1 ** state["step"]
+                bias2 = 1 - beta2 ** state["step"]
+                denom = (exp_avg_sq / bias2).sqrt_().add_(group["eps"])
+                param.addcdiv_(exp_avg, denom, value=-lr / bias1)
+
