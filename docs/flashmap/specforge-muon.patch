diff --git a/tests/test_optimizer/test_bf16_optimizer_muon.py b/tests/test_optimizer/test_bf16_optimizer_muon.py
new file mode 100644
index 0000000..a8f3edc
--- /dev/null
+++ b/tests/test_optimizer/test_bf16_optimizer_muon.py
@@ -0,0 +1,82 @@
+import unittest
+from unittest import mock
+
+import torch
+
+from specforge.optimizer import BF16Optimizer
+
+
+class _Draft(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.embed_tokens = torch.nn.Embedding(16, 8)
+        self.proj = torch.nn.Linear(8, 32)
+        self.norm = torch.nn.LayerNorm(32)
+        self.lm_head = torch.nn.Linear(32, 16, bias=False)
+
+    def forward(self, tokens):
+        return self.lm_head(self.norm(self.proj(self.embed_tokens(tokens))))
+
+
+def _train(optimizer_type, steps=60):
+    torch.manual_seed(0)
+    model = _Draft()
+    opt = BF16Optimizer(
+        model,
+        lr=1e-2,
+        weight_decay=0.1,
+        total_steps=steps,
+        warmup_ratio=0.0,
+        betas=(0.9, 0.95),
+        decay_matrices_only=True,
+        optimizer=optimizer_type,
+        max_grad_norm=1.0,
+    )
+    tokens = torch.arange(16)
+    losses = []
+    for _ in range(steps):
+        loss = torch.nn.functional.cross_entropy(model(tokens), tokens)
+        loss.backward()
+        opt.step()
+        losses.append(loss.item())
+    return model, opt, losses
+
+
+class TestMuon(unittest.TestCase):
+    def test_only_hidden_matrices_use_muon(self):
+        model, opt, _ = _train("muon", steps=1)
+        muon, decay, no_decay = opt.optimizer.param_groups
+        self.assertTrue(muon["use_muon"])
+        self.assertEqual([p.shape for p in muon["params"]], [model.proj.weight.shape])
+        self.assertEqual([p.shape for p in decay["params"]], [model.lm_head.weight.shape])
+        self.assertEqual(no_decay["weight_decay"], 0.0)
+        self.assertEqual(len(no_decay["params"]), 4)  # embed, bias, norm w/b
+
+    def test_muon_learns(self):
+        _, _, losses = _train("muon")
+        self.assertLess(losses[-1], 0.5 * losses[0])
+
+    def test_resume_rejects_other_optimizer(self):
+        _, muon_opt, _ = _train("muon", steps=2)
+        _, adam_opt, _ = _train("adamw", steps=2)
+        with self.assertRaisesRegex(ValueError, "checkpoint optimizer is"):
+            adam_opt.load_state_dict(muon_opt.state_dict())
+
+    def test_resume_round_trip(self):
+        _, opt, _ = _train("muon", steps=3)
+        _, fresh, _ = _train("muon", steps=1)
+        with mock.patch("specforge.optimizer.print_on_rank0"):
+            fresh.load_state_dict(opt.state_dict())
+        self.assertEqual(fresh.optimizer.state_dict()["state"].keys(),
+                         opt.optimizer.state_dict()["state"].keys())
+
+    def test_flat_shards_are_refused(self):
+        model = torch.nn.Linear(4, 4, bias=False)
+        model.weight._specforge_shape = (4, 4)
+        model.weight.data = model.weight.data.flatten()
+        with self.assertRaisesRegex(ValueError, "NO_SHARD"):
+            BF16Optimizer(model, lr=1e-3, weight_decay=0.1, optimizer="muon")
+
+
+if __name__ == "__main__":
+    unittest.main()
