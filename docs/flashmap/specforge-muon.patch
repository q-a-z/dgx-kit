+    def _muon_param_groups(self, weight_decay):
+        """Muon takes the hidden weight matrices; embeddings, any ``lm_head``
+        and every non-matrix param stay on AdamW, as in Moonlight. Decay
+        follows ``decay_matrices_only``: norms, biases and embeddings get none."""
+        names = {id(param): name for name, param in self.model.named_parameters()}
+        embeddings = {
+            id(module.weight)
+            for module in self.model.modules()
+            if isinstance(module, torch.nn.Embedding)
+        }
+        muon, adam_decay, adam_no_decay = [], [], []
+        for param, master in zip(self.model_params, self.fp32_params):
+            name = names.get(id(param), "")
+            if not _is_matrix(param) or id(param) in embeddings:
+                adam_no_decay.append(master)
+            elif "lm_head" in name or "embed" in name:
+                adam_decay.append(master)
+            elif master.ndim != 2:
+                # ponytail: no gather of sharded matrices (Moonlight's
+                # Distributed Muon); add it if a draft needs FSDP sharding.
+                raise ValueError(
+                    f"Muon needs whole 2-D matrices but {name or 'a param'} has "
+                    f"shape {tuple(master.shape)}; use fsdp_sharding: NO_SHARD"
+                )
+            else:
+                muon.append(master)
+        return [
+            {"params": muon, "use_muon": True},
+            {"params": adam_decay},
+            {"params": adam_no_decay, "weight_decay": 0.0},
+        ]
