+#ifndef CUTLASS_ARCH_MMA_SM120_ENABLED
+#define CUTLASS_ARCH_MMA_SM120_ENABLED 1
+#endif
+#ifndef CUTLASS_ARCH_MMA_SM120A_ENABLED
+#define CUTLASS_ARCH_MMA_SM120A_ENABLED 1
+#endif
+#endif
